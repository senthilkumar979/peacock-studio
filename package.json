{
  "name": "peacock",
  "private": true,
  "scripts": {
    "test": "pnpm --filter @peacock/shared test && pnpm --filter @peacock/app test",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:extension": "pnpm --filter @peacock/extension dev",
    "build:extension": "pnpm --filter @peacock/extension build",
    "package:extension": "pnpm --filter @peacock/extension package",
    "dev:app": "pnpm --filter @peacock/app dev",
    "build:app": "pnpm --filter @peacock/app build"
  },
  "engines": {
    "node": ">=20"
  }
}
